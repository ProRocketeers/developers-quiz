---
import Header from "../components/Header";
import Footer from "../components/Footer";
import "../index.css";
import "./Layout.css";
import "bootstrap/dist/css/bootstrap.min.css";
import type { Locale } from "../i18n/locales";

interface Props {
  locale: Locale;
  title: string;
  currentPath?: string;
}

const { locale, title, currentPath = "/" } = Astro.props as Props;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <div class="layout">
      <Header locale={locale} currentPath={currentPath} client:load />
      <main class="main">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
