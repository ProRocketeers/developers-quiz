---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CertificationQuizView from "../../views/CertificationQuizView";
import { getRequestLocale } from "../../i18n/requestLocale";
import { getMessages } from "../../i18n/messages";

const locale = getRequestLocale(Astro.cookies);
const pageTitle = getMessages(locale).pageTitles.certificationQuiz;
---

<BaseLayout locale={locale} title={pageTitle} currentPath="/certifications">
  <CertificationQuizView locale={locale} client:only="react" />
</BaseLayout>
