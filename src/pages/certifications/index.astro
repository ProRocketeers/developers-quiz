---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { countQuestionsByExam } from "../../services/certificationQuestionService";
import CertificationHomeView from "../../views/CertificationHomeView";
import { getRequestLocale } from "../../i18n/requestLocale";
import { getMessages } from "../../i18n/messages";

const questionCounts = await countQuestionsByExam();
const locale = getRequestLocale(Astro.cookies);
const pageTitle = getMessages(locale).pageTitles.certifications;
---

<BaseLayout locale={locale} title={pageTitle} currentPath="/certifications">
  <CertificationHomeView locale={locale} questionCounts={questionCounts} client:only="react" />
</BaseLayout>
